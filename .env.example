# Copy this file to .env and adjust as needed, then run: docker compose up -d

# --- MySQL -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=znotex_root
MYSQL_DATABASE=znotex
MYSQL_USER=znotex
MYSQL_PASSWORD=znotex

# --- ZnoteX --------------------------------------------------------------
ZNOTE_SITE_URL=http://localhost:8080
ZNOTE_SITE_TITLE=ZnoteX
# One of: TFS_10 (TFS 1.1-1.4.2), TFS_16 (TFS 1.6), CANARY (Canary/OTServBR-Global),
# TFS_03 (TFS 0.3.6+/0.4/OTX), TFS_02 (TFS 0.2.13+), OTHIRE.
# Picks which game database schema gets imported on first boot - only TFS_10 ships
# with demo accounts/characters, the others get the correct empty schema.
# Changing this after the first `docker compose up -d` has no effect; wipe the db
# volume (docker compose down -v) to switch engines.
ZNOTE_SERVER_ENGINE=TFS_10
# Account name granted admin panel access - matches the TFS_10 demo data seed.
ZNOTE_ADMIN_ACCOUNT=demo

# --- Ports on your machine ------------------------------------------------
ZNOTEX_HTTP_PORT=8080
ZNOTEX_DB_PORT=3306
ZNOTEX_PMA_PORT=8081
ZNOTEX_MAILPIT_SMTP_PORT=1025
ZNOTEX_MAILPIT_WEB_PORT=8025
