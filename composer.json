{
    "name": "open-games-community/znotex",
    "description": "ZnoteX - a complete website for your Open Tibia server.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/Open-Games-Community/ZnoteX",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^7.1"
    },
    "autoload": {
        "classmap": [
            "engine/function/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse"
    }
}
